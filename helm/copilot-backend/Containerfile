# Build stage - install dependencies
FROM python:3.12-slim AS builder

# Install uv for fast dependency management
RUN pip install --no-cache-dir uv

# Set working directory
WORKDIR /app

# Copy project files
COPY packages/copilot/pyproject.toml /app/
COPY packages/copilot/README.md /app/
COPY packages/copilot/src /app/src

# Install dependencies using uv
RUN uv venv /tmp/copilot/.venv && \
    . /tmp/copilot/.venv/bin/activate && \
    uv pip install .

# Runtime stage
FROM python:3.12-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    dnsutils \
    iputils-ping \
    net-tools \
    && rm -rf /var/lib/apt/lists/*

# Copy virtual environment from builder
COPY --from=builder /tmp/copilot/.venv /app/.venv

# Copy source code
COPY --from=builder /app/src /app/src

# Fix shebangs to point to /app instead of /tmp/copilot
RUN find /app/.venv/bin -type f -exec sed -i 's|#!/tmp/copilot/.venv/bin/python|#!/app/.venv/bin/python|g' {} \;

# OpenShift compatibility: support arbitrary user IDs
RUN chmod -R g=u /app && \
    chgrp -R 0 /app

WORKDIR /app

# Expose port
EXPOSE 8080

# Run the FastAPI server
CMD ["/app/.venv/bin/python", "-m", "copilot"]
