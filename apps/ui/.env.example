# Copilot Backend Configuration
# URL for the copilot-backend service

# For local development (when running backend locally or via port-forward)
VITE_COPILOT_BACKEND_URL=http://localhost:8080

# For production (when deployed in OpenShift - use the route URL)
# VITE_COPILOT_BACKEND_URL=https://copilot-backend-your-namespace.apps.example.com
