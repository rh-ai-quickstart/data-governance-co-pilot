# MCP Server Configuration
# URL for the pg-airman-mcp server (streamable-http transport)
# Note: /mcp endpoint is added automatically by the service
# PG_AIRMAN_MCP_SERVICE_PORT=http://pg-airman-mcp-service:8000

# For local development (if running pg-airman-mcp locally via port-forward)
PG_AIRMAN_MCP_SERVICE_PORT=http://localhost:8000

# LLM Configuration
# URL for the Nemotron vLLM inference server (OpenAI-compatible API)
# LLM_BASE_URL=http://nemotron-service:8000/v1

# For local development or different deployment
LLM_BASE_URL=http://localhost:8001/v1

# Model name to use (should match what's deployed in vLLM)
LLM_MODEL=nvidia/nemotron-nano-9b-v2

# API key for LLM service (if required)
# For vLLM servers without authentication, use "not-needed"
# For OpenShift AI or secured endpoints, provide the actual API key
LLM_API_KEY=not-needed
